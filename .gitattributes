# Normalise text to LF in the repository, and check it out native.
* text=auto

# Windows tooling reads these; keep them CRLF on disk regardless of platform.
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.csproj text eol=crlf
*.manifest text eol=crlf

# Never line-ending-convert these. The intro artwork is compiled into Dovetail.exe
# as a WPF resource, and a converted PNG is a corrupt PNG.
*.png   binary
*.jpg   binary
*.jfif  binary
*.mp4   binary
*.dll   binary
*.exe   binary
