<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Dovetail.Core</RootNamespace>
    <AssemblyName>Dovetail.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Dovetail</Product>
    <AssemblyTitle>Dovetail Core - HID capture, calibration, translation, virtual pad</AssemblyTitle>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- User-mode client for the ViGEmBus driver. 1.21.256 pairs with the driver already
         installed on this machine (ViGEmBus.sys 1.21.442.0, see Findings Log 0.7). -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
