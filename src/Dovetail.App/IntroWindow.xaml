<Window x:Class="Dovetail.App.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dovetail"
        Width="760" Height="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
  <!-- Topmost because this is the very first thing the application ever shows, and it has no
       taskbar button to find it by. Findings Log 5.9 records the same fault in the handover
       dialog: created with no owner, Windows was free to leave it behind a browser, and the
       one message telling the operator where the application had gone could be missed
       entirely. A splash that opens behind the window you were already reading is worse than
       no splash. -->

  <!-- One rounded card on a transparent window, so the intro reads as an object rather than
       as a rectangle of application. AllowsTransparency means no system chrome, which is the
       point: nothing but the artwork. -->
  <Border x:Name="Card" CornerRadius="10" Background="{StaticResource Ink}"
          BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="20,18,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Wordmark, same lockup as every other window -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                  Opacity="0" x:Name="Lockup">
        <Rectangle Width="24" Height="24" Fill="{StaticResource Mark}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Style="{StaticResource Wordmark}" Text="dovetail" FontSize="22"/>
      </StackPanel>

      <!-- The drawing sheet. The artwork was generated on white, so it stays on white here
           and the sheet becomes a deliberate part of the design rather than a keying problem
           to solve. It is also why the cross-dissolve to the assembled render is seamless:
           both images share the same ground. -->
      <!-- Pure white, not an off-white, on purpose. Both source renders were generated on
           white, so the assembled one can fade in over the exploded one with no visible plate
           edge. An off-white card would outline the hero image as a rectangle. -->
      <Border Grid.Row="1" Margin="0,16,0,12" CornerRadius="6" Background="#FFFFFF"
              ClipToBounds="True">
        <Viewbox Stretch="Uniform" Margin="10">
          <Grid Width="1833" Height="1400">

            <!-- exploded layers, filled in from PadArtwork at construction -->
            <Canvas x:Name="Sheet" Width="1833" Height="1400"/>

            <!-- the assembled render, faded in over the closed shell at the end -->
            <Image x:Name="Hero" Opacity="0" Stretch="Uniform"
                   Width="1560" Height="1246"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="HeroScale" ScaleX="0.94" ScaleY="0.94"/>
                  <RotateTransform x:Name="HeroSpin" Angle="-3"/>
                </TransformGroup>
              </Image.RenderTransform>
            </Image>
          </Grid>
        </Viewbox>
      </Border>

      <TextBlock Grid.Row="2" x:Name="Caption" HorizontalAlignment="Center" Opacity="0"
                 Style="{StaticResource Dim}" FontSize="13"
                 Text="Fits your pad to the game"/>
    </Grid>
  </Border>
</Window>
