<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Dovetail.App</RootNamespace>
    <AssemblyName>Dovetail</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- WinForms is pulled in only for NotifyIcon, which is the tray icon and the toast
         mechanism. WPF has no tray primitive of its own, and NotifyIcon balloon tips render
         as Action Center toasts on Windows 10 without needing a packaged identity or an
         AppUserModelID, which a WinUI toast would require. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The mark, embedded as the exe's Win32 icon. Explorer, the Start Menu and desktop
         shortcuts, Add/Remove Programs, and every WPF window's title bar and taskbar button
         read this; without it they all fall back to the default program icon, and only the
         tray (drawn in code by TrayIcon) shows the mark. 16-64 px are bitmaps, 256 px is PNG,
         rendered from the same geometry as TrayIcon.MarkHalf. -->
    <ApplicationIcon>Dovetail.ico</ApplicationIcon>
    <!-- WFAC010 tells WinForms apps to set DPI mode via Application.SetHighDpiMode instead
         of in the manifest. That advice does not apply here. This is a WPF app that borrows
         one WinForms control, and WPF reads DPI awareness from the manifest before any
         managed code runs; SetHighDpiMode would be too late for it and WPF does not honour
         it in any case. The manifest is the only mechanism that works for this process. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Deliberately NOT InvariantGlobalization. The console tools set it, because it drops
         the ICU dependency and they only ever format numbers. WPF cannot live without it:
         its font cache builds a CultureInfo("en") while measuring the first TextBlock, which
         throws CultureNotFoundException in invariant mode and takes the process down before
         any window appears. Verified by the crash it caused, see Findings Log 5.4. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF and WinForms ship localised resource assemblies for their own exception text in
         13 languages. A self-contained publish copies all of them, and the application is
         English-only, so they are 13 folders of weight nobody reads. This drops them without
         touching InvariantGlobalization, which WPF genuinely needs. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Shown in Task Manager and in the file's Details tab. -->
    <Product>Dovetail</Product>
    <AssemblyTitle>Dovetail Gamepad Emulator</AssemblyTitle>
    <Company>Dovetail</Company>
    <Version>1.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dovetail.Core\Dovetail.Core.csproj" />
  </ItemGroup>

  <!-- The controller artwork, compiled into the assembly rather than copied beside it.
       Same reasoning as the tray icon: nothing to go missing at runtime, and no path to
       resolve. These are the project's own original renders, segmented into animatable
       layers by the pipeline described in Findings Log 5.6.7. -->
  <ItemGroup>
    <Resource Include="..\..\assets\intro\*.png" Link="assets\intro\%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\intro\*.jpg" Link="assets\intro\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
