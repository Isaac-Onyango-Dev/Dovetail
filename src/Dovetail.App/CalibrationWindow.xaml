<Window x:Class="Dovetail.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Dovetail - controller setup"
        MinWidth="720" MinHeight="640">

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============================================================ header -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Rectangle Width="22" Height="22" Fill="{StaticResource Mark}"
                   VerticalAlignment="Center" Margin="0,0,9,0"/>
        <TextBlock Style="{StaticResource Wordmark}" FontSize="19" Text="dovetail"/>
        <TextBlock Style="{StaticResource Tagline}" x:Name="SlotLine" Text="Player 1"/>
      </StackPanel>

      <TextBlock Grid.Column="1" x:Name="Counter" Style="{StaticResource Mono}"
                 VerticalAlignment="Center" Text=""/>
    </Grid>

    <!-- ============================================================ progress -->
    <!-- A plain track rather than a ProgressBar: the stock control carries its own chrome and
         an animation that fights the theme, and all this needs to show is how far along the
         list the operator is. -->
    <Border x:Name="Track" Grid.Row="1" Height="3" Margin="0,14,0,0" CornerRadius="2"
            Background="{StaticResource Line}" HorizontalAlignment="Stretch">
      <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left"
              CornerRadius="2" Background="{StaticResource Accent}"/>
    </Border>

    <!-- ============================================================ diagram -->
    <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="6" Background="#F7F7F5"
            ClipToBounds="True">
      <Grid>
        <!-- SizeChanged on this grid is what places the highlight: the hotspots are stored as
             fractions of the image, so they only become pixels once the image has been laid
             out. -->
        <Grid x:Name="DiagramHost" Margin="16">
          <Image x:Name="Pad" Stretch="Uniform"/>
          <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
        </Grid>

        <!-- Callout for the four inputs the render cannot show. The assembled view is a
             three-quarter view from above and the rear edge is fully occluded, so L1, L2, R1
             and R2 have no geometry to highlight. This panel shows the trigger assembly cut
             from the exploded view, where both are drawn as separate labelled parts. -->
        <Border x:Name="Callout" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource Accent}"
                BorderThickness="2" Padding="12,10">
          <StackPanel>
            <TextBlock x:Name="CalloutTitle" Text="Rear edge" Foreground="#14171C"
                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <Image x:Name="CalloutImage" Width="104" Height="150" Stretch="Uniform"
                   Margin="0,6,0,4"/>
            <TextBlock x:Name="CalloutNote" Foreground="#5C6572" FontSize="11"
                       TextAlignment="Center" MaxWidth="130"
                       Text="Underneath, where you cannot see it in this view"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============================================================ prompt -->
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock x:Name="Prompt" FontSize="26" FontWeight="Bold"
                 HorizontalAlignment="Center" TextAlignment="Center"
                 Text="Starting..."/>

      <!-- The dual label, e.g. "B / Circle". Deliberately a separate, quieter element rather
           than part of the prompt: the prompt names the control by POSITION because the sweep
           exists to discover an unknown layout, and a prompt that led with a letter would
           invite somebody holding the other kind of pad to press whatever looked closest.
           This resolves "which one do you mean" for a person who knows their own pad, without
           ever becoming the instruction. Collapsed for controls named the same everywhere. -->
      <Border x:Name="DualLabelChip" Visibility="Collapsed"
              HorizontalAlignment="Center" Margin="0,8,0,0"
              CornerRadius="11" Padding="12,3"
              Background="#22D9483B" BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="on your pad:" FontSize="11" VerticalAlignment="Center"
                     Foreground="{StaticResource TextDim}" Margin="0,0,7,0"/>
          <TextBlock x:Name="DualLabelText" FontSize="14" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{StaticResource Text}" Text=""/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="Hint" Style="{StaticResource Dim}" FontSize="13"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                 Text="Finding your controller"/>
      <TextBlock x:Name="NudgeText" Foreground="{StaticResource Warn}" FontSize="12"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                 Opacity="0" Text=""/>

      <!-- Re-test one input, shown only on the summary. Without this, correcting a single
           missed press means sitting through all twenty-seven again, which is why the first
           live pass recorded inputs the operator knew were wrong and carried on regardless. -->
      <StackPanel x:Name="RetestPanel" Visibility="Collapsed" Orientation="Horizontal"
                  HorizontalAlignment="Center" Margin="0,14,0,0">
        <TextBlock Text="Re-test" VerticalAlignment="Center" Margin="0,0,8,0"
                   Style="{StaticResource Dim}"/>
        <!-- An explicit ItemTemplate, not DisplayMemberPath: the themed ComboBox template
             renders the selection through SelectionBoxItemTemplate, which DisplayMemberPath
             does not populate, so the box showed the record's ToString. Same defect as the
             preset picker in the settings window; see the note on the ComboBox style. -->
        <ComboBox x:Name="RetestPick" Width="300" Height="28" VerticalContentAlignment="Center"
                  SelectedValuePath="Id" Margin="0,0,8,0">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="RetestOneBtn" Content="Just this one" Click="RetestOne_Click"
                Margin="0,0,8,0"/>
        <Button x:Name="RetestMissedBtn" Content="All not seen" Click="RetestMissed_Click"/>
      </StackPanel>
    </StackPanel>

    <!-- ============================================================ controls -->
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click"/>

      <TextBlock Grid.Column="1" x:Name="Status" Style="{StaticResource Mono}"
                 VerticalAlignment="Center" HorizontalAlignment="Center" Text=""/>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="SkipBtn" Content="Skip this input" Click="Skip_Click" Margin="0,0,8,0"/>
        <Button x:Name="DoneBtn" Style="{StaticResource Primary}" Content="Continue"
                Click="Done_Click" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
