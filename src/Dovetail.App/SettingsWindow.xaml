<Window x:Class="Dovetail.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Dovetail settings"
        MinWidth="740" MinHeight="460"
        ResizeMode="CanResize">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Rectangle Width="26" Height="26" Fill="{StaticResource Mark}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Style="{StaticResource Wordmark}" Text="dovetail"/>
        <TextBlock Style="{StaticResource Tagline}" Text="Fits your pad to the game"/>
      </StackPanel>
      <TextBlock x:Name="BusLine" Style="{StaticResource Mono}"/>
    </StackPanel>

    <TabControl Grid.Row="1">

      <TabItem Header="Controllers">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                       Text="Player 1 is whoever connects first. A controller with no calibration is left alone and gets no virtual controller, so nothing is translated with another pad's numbers."/>
            <ItemsControl x:Name="SlotList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="15"
                                   Text="{Binding Title}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                                 Text="{Binding Detail}"/>
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"
                                   Style="{StaticResource Dim}"/>
                        <TextBox Grid.Column="1" Margin="0,0,8,0"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Save" Tag="{Binding Slot}"
                                Click="SaveName_Click"/>
                      </Grid>
                      <!-- ============================================ stick feel -->
                      <Separator Margin="0,14,0,10" Background="{StaticResource Line}"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stick feel" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TravelText}"
                                   Foreground="{Binding TravelBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="118"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center"
                                   Style="{StaticResource Dim}"/>
                        <!-- An explicit ItemTemplate rather than DisplayMemberPath. The custom
                             ComboBox template renders the selected value through
                             SelectionBoxItemTemplate, and DisplayMemberPath did not populate
                             it, so the box showed the record's ToString: the whole
                             "Preset { Id = standard, Label = ... }" dump. Seen on screen. -->
                        <ComboBox Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Left"
                                  Width="200"
                                  ItemsSource="{Binding Presets}" SelectedValuePath="Id"
                                  SelectedValue="{Binding PresetId, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="118,0,0,10"
                                 Text="{Binding PresetSummary}"/>

                      <!-- Each row: label, slider, live value. The slider moves the number and
                           the number is shown beside it, because a bare slider gives no way to
                           tell somebody what value to set, and these four are the numbers the
                           findings log and the tune command both talk about by value. -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="118"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Deadzone"
                                   VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        <Slider Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                                Minimum="{Binding DeadzoneMin}" Maximum="{Binding DeadzoneMax}"
                                Value="{Binding Deadzone, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DeadzoneText}"
                                   Style="{StaticResource Mono}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Anti-deadzone"
                                   VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        <Slider Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"
                                Minimum="{Binding AntiDeadzoneMin}" Maximum="{Binding AntiDeadzoneMax}"
                                LargeChange="500" SmallChange="50"
                                Value="{Binding AntiDeadzone, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AntiDeadzoneText}"
                                   Style="{StaticResource Mono}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Saturation"
                                   VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        <Slider Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"
                                Minimum="{Binding SaturationMin}" Maximum="{Binding SaturationMax}"
                                Value="{Binding Saturation, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SaturationText}"
                                   Style="{StaticResource Mono}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Response curve"
                                   VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        <Slider Grid.Row="3" Grid.Column="1" Margin="0,0,10,0"
                                Minimum="{Binding CurveMin}" Maximum="{Binding CurveMax}"
                                LargeChange="0.1" SmallChange="0.05"
                                Value="{Binding ResponseCurve, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CurveText}"
                                   Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0"
                                 Text="Saturation is how far you have to push, out of 127, before the game sees full deflection. Anti-deadzone is the output the first movement produces, to clear the deadzone the game applies on top of ours. A running game picks up Apply within a second."/>

                      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply stick feel" Style="{StaticResource Primary}"
                                Tag="{Binding Slot}" Click="ApplyFeel_Click"
                                IsEnabled="{Binding Dirty}" Margin="0,0,8,0"/>
                        <Button Content="Revert" Tag="{Binding Slot}" Click="RevertFeel_Click"
                                IsEnabled="{Binding Dirty}"/>
                      </StackPanel>

                      <Separator Margin="0,14,0,10" Background="{StaticResource Line}"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Re-calibrate" Tag="{Binding Slot}"
                                Click="Recalibrate_Click" Margin="0,0,8,0"/>
                        <Button Content="Forget this controller" Tag="{Binding Slot}"
                                Click="Forget_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddControllerBtn" Content="Set up another controller"
                    HorizontalAlignment="Left" Click="AddController_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Games">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,6"
                       Text="Register a game and Dovetail applies its stick settings whenever that game is running. Dovetail never launches games: start them from their own shortcuts as usual."/>
            <TextBlock x:Name="ActiveGameLine" Style="{StaticResource Mono}" Margin="0,0,0,10"/>
            <ItemsControl x:Name="GameList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Mono}" Text="{Binding ExecutableName}"/>
                      <TextBlock Style="{StaticResource Mono}" Text="{Binding FullPath}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Remove" Tag="{Binding ExecutableName}"
                                Click="RemoveGame_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add a game..." HorizontalAlignment="Left" Click="AddGame_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Notifications">
        <StackPanel Margin="0,14,0,0">
          <CheckBox x:Name="NotifyConnect" Content="Show a notification when a controller connects"/>
          <CheckBox x:Name="NotifyDisconnect" Content="Show a notification when a controller disconnects"/>
          <CheckBox x:Name="NotifyUnrecognised" Content="Show a notification when an unrecognised controller connects"/>
          <TextBlock Style="{StaticResource Dim}" Margin="24,2,0,12" FontSize="12"
                     Text="The unrecognised notice appears once per connection and can be clicked to calibrate. It is never repeated on a timer while the controller sits idle."/>
          <Separator Margin="0,8"/>
          <CheckBox x:Name="AutoStartBox" Content="Start Dovetail when I sign in to Windows"
                    Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
          <TextBlock x:Name="AutoStartDetail" Style="{StaticResource Mono}" Margin="24,2,0,0"/>
          <Separator Margin="0,12,0,8"/>
          <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,0,0,8"
                     Text="The opening animation plays once, on the very first launch. This is the only way to see it again."/>
          <Button Content="Play the intro again" HorizontalAlignment="Left" Click="ReplayIntro_Click"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Dependencies">
        <StackPanel Margin="0,14,0,0">
          <TextBlock x:Name="DepText" Style="{StaticResource Mono}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Check again" Click="DepRecheck_Click" Margin="0,0,8,0"/>
            <Button Content="Repair dependencies" Click="DepRepair_Click"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
